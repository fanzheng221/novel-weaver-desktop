# Optional overrides. The app works without these variables or an embedding model.
# Desktop and core share this machine-local directory (default: ~/.novel-weaver/semantic).
# NOVEL_WEAVER_EXTENSION_DIR=/absolute/path/to/semantic

# Used only after explicitly choosing an existing Ollama runtime in settings.
# NOVEL_WEAVER_OLLAMA_BASE_URL=http://127.0.0.1:11434
# NOVEL_WEAVER_EMBEDDING_MODEL=qwen3-embedding:0.6b
# NOVEL_WEAVER_EMBEDDING_DIMENSION=1024
# NOVEL_WEAVER_EMBEDDING_QUERY_INSTRUCTION=Retrieve relevant novel passages.

# Development overrides; production bundles carry their own Node and core.
# NOVEL_WEAVER_NODE=/absolute/path/to/node
# NOVEL_WEAVER_CORE_SCRIPT=/absolute/path/to/local-core/cli.ts
# NOVEL_WEAVER_MIGRATIONS_DIR=/absolute/path/to/migrations
